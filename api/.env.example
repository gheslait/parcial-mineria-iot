# Copia este archivo a .env y coloca la cadena real. .env está en .gitignore.
# Formato SQLAlchemy: postgresql+psycopg2://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg2://usuario:clave@gheslait.com:15432/timescaledb

# Schema propio del grupo (aísla las tablas si la BD es compartida entre equipos).
DB_SCHEMA=combustion_riesgo

# Identificación del grupo/dispositivo por defecto (Fase 2: "identificación del grupo").
GRUPO_NOMBRE=Grupo Riesgo de Combustion
GRUPO_NUMERO=1
DISPOSITIVO_CODIGO=ESP32-COMB-01

# Servidor
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
